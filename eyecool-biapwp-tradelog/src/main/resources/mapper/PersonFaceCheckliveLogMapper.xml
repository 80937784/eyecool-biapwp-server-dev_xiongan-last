<mapper namespace="cn.eyecool.tradelog.mapper.PersonFaceCheckliveLogMapper">
    
    <resultMap type="PersonFaceCheckliveLog" id="PersonFaceCheckliveLogResult">
        <result property="id"    column="id"    />
