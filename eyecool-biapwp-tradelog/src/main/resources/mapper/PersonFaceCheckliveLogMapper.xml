    <sql id="selectPersonFaceCheckliveLogVo">
        select id, channel_code, scene_image, scene_video, checklive_score, checklive_msg, checklive_result, threshold, received_time, time_used, server_id, algs_version, vendor_code, create_time, batch_date, tenant_id from person_face_checklive_log
    </sql>

    <select id="selectPersonFaceCheckliveLogList" parameterType="PersonFaceCheckliveLog" resultMap="PersonFaceCheckliveLogResult" databaseId="mysql">
        <include refid="selectPersonFaceCheckliveLogVo"/>
        <where>  
            <if test="channelCode != null  and channelCode != ''"> and channel_code = #{channelCode}</if>
            <if test="sceneImage != null  and sceneImage != ''"> and scene_image = #{sceneImage}</if>
            <if test="sceneVideo != null  and sceneVideo != ''"> and scene_video = #{sceneVideo}</if>
            <if test="checkliveScore != null "> and checklive_score = #{checkliveScore}</if>
            <if test="checkliveMsg != null  and checkliveMsg != ''"> and checklive_msg = #{checkliveMsg}</if>
            <if test="checkliveResult != null  and checkliveResult != ''"> and checklive_result = #{checkliveResult}</if>
            <if test="threshold != null "> and threshold = #{threshold}</if>
            <if test="timeUsed != null "> and time_used = #{timeUsed}</if>
            <if test="serverId != null  and serverId != ''"> and server_id = #{serverId}</if>
            <if test="algsVersion != null  and algsVersion != ''"> and algs_version = #{algsVersion}</if>
            <if test="vendorCode != null  and vendorCode != ''"> and vendor_code = #{vendorCode}</if>
            <if test="batchDate != null "> and batch_date = #{batchDate}</if>
            <if test="tenantId != null  and tenantId != ''"> and tenant_id = #{tenantId}</if>
            <if test="beginTime != null and beginTime != ''"><!-- 开始时间检索 -->
				and date_format(received_time,'%y%m%d') &gt;= date_format(#{beginTime},'%y%m%d')
			</if>
			<if test="endTime != null and endTime != ''"><!-- 结束时间检索 -->
				and date_format(received_time,'%y%m%d') &lt;= date_format(#{endTime},'%y%m%d')
			</if>
        </where>
    </select>
    
    <select id="selectPersonFaceCheckliveLogById" parameterType="String" resultMap="PersonFaceCheckliveLogResult">
        <include refid="selectPersonFaceCheckliveLogVo"/>
        where id = #{id}
    </select>
        
