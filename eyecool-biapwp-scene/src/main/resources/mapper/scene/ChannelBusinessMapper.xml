            <if test="faceIrisMode != null  and faceIrisMode != ''"> and busi.face_iris_mode = #{faceIrisMode}</if>
            <if test="datasource != null  and datasource != ''"> and busi.datasource = #{datasource}</if>
            <if test="locked != null  and locked != ''"> and busi.locked = #{locked}</if>
            <if test="lockTime != null "> and busi.lock_time = #{lockTime}</if>
            <if test="status != null  and status != ''"> and busi.status = #{status}</if>
            <if test="batchDate != null "> and busi.batch_date = #{batchDate}</if>
