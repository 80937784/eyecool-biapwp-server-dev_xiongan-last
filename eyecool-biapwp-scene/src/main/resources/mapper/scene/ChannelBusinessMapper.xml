    <select id="selectUnbindPersonInfoList" resultMap="cn.eyecool.basedata.mapper.BasePersonInfoMapper.BasePersonInfoResult" databaseId="mysql">
         select
			base.id,
			base.unique_id,
			base.name,
			base.sex,
			base.phone,
			base.card_no,
			base.account,
			base.email,
			base.dept_id,
			base.flag,
			base.status,
			base.create_by,
			base.update_by,
			base.create_time,
			base.update_time,
			base.tenant_id 	
		from
			base_person_info base 
		where
			not exists ( select busi.person_id from channel_business busi where busi.person_id = base.id and busi.status = '0' and busi.channel_id = #{channelId} ) 
			and base.status = '0'
            and base.person_type='user'
        <if test="basePersonInfo != null">
            <if test="basePersonInfo.uniqueId != null  and basePersonInfo.uniqueId != ''"> and base.unique_id = #{basePersonInfo.uniqueId}</if>
            <if test="basePersonInfo.name != null  and basePersonInfo.name != ''"> and base.name like concat(concat('%', #{basePersonInfo.name}), '%')</if>
            <if test="basePersonInfo.phone != null  and basePersonInfo.phone != ''"> and base.phone = #{basePersonInfo.phone}</if>
            <if test="basePersonInfo.deptId != null "> and (base.dept_id = #{basePersonInfo.deptId} or base.dept_id in ( select t.dept_id from sys_dept t where find_in_set(#{basePersonInfo.deptId}, ancestors)))</if>
        </if>
    </select>

    <!-- 实时同步渠道业务更新数据标识最大流水码查询 -->
    <select id="selectLiveUpdateMaxSeriaNum" resultType="Long">
        select max(update_seria_num) from channel_business
    </select>

    <delete id="deleteChannelBusinessByChannelIds" parameterType="String">
        delete from channel_business where channel_id in
        <foreach collection="array" item="channelId" open="(" separator="," close=")">
            #{channelId}
        </foreach>
    </delete>


    <!-- 实时同步更新数据查询 -->
    <select id="selectLiveUpdateBasePersonInfoList" parameterType="Map" resultType="BasePersonLiveUpdateInfo" databaseId="mysql">
        SELECT
			base.id,
			base.unique_id as uniqueId,
			base.name,
			base.sex,
			base.phone,
			base.card_no as cardNo,
			base.account,
			base.email,
			base.flag,
			base.ext_attrs as extAttrs,
            base.person_type as personType,
            base.effective_begin_time as effectiveBeginTime,
            base.effective_end_time as effectiveEndTime,
            base.effective_begin_time as permitStartDate,
            base.effective_end_time as permitEndDate,
            '00:00:00-23:59:59' as permitInoutTime,
			case
				when base.status = '0' and busi.status = '0'  <if test="sbusiUpdateSeriaNum != null"> and sbusi.status = '0' </if> then '0'
				else '1' 
			end as status,
			base.update_time as updateTime,
        <if test="busiUpdateSeriaNum != null">
				busi.update_seria_num as busiUpdateSeriaNum,
        </if>
        <if test="sbusiUpdateSeriaNum != null">
				sbusi.update_seria_num as sbusiUpdateSeriaNum,
				sbusi.sub_treasury_id as subTreasuryId,
				sbusi.device_mgr as deviceMgr,
        </if>
			busi.face_mode as faceMode,
			busi.finger_mode as fingerMode,
			busi.iris_mode as irisMode,
			busi.fvein_mode as fveinMode,
			busi.face_iris_mode as faceIrisMode,
			busi.locked,
			dept.dept_code as deptCode,
			dept.dept_name as deptName
		from
			base_person_info base
		inner join 
			channel_business busi
		on  
			busi.person_id = base.id and busi.channel_id = #{channelId}
        <if test="sbusiUpdateSeriaNum != null and subtreasuryIds != null and subtreasuryIds.length > 0">
			inner join (
				select
					person_id,
					group_concat( sub_treasury_id ) as sub_treasury_id,
					max( update_seria_num ) as update_seria_num,
					min(status) as status,
					max(device_mgr) as device_mgr,
					channel_id 
				from
					channel_subtreasury_busi 
				where 
					 channel_id = #{channelId} and sub_treasury_id in 
            <foreach item="subId" collection="subtreasuryIds" open="(" separator="," close=")">
				    #{subId}
            </foreach>
				group by person_id 
			) sbusi on sbusi.person_id = base.id 
			and sbusi.channel_id = busi.channel_id 
        </if>
		left join 
			sys_dept dept
		on 
			base.dept_id = dept.dept_id 
        <where>
            <if test="busiUpdateSeriaNum != null"> or busi.update_seria_num &gt; #{busiUpdateSeriaNum}</if>
            <if test="sbusiUpdateSeriaNum != null"> or sbusi.update_seria_num &gt; #{sbusiUpdateSeriaNum}</if>
        </where>
    </select>
</mapper>