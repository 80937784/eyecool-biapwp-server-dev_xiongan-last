    <sql id="selectChannelBusinessVo">
        select busi.id, busi.channel_id, busi.person_id, busi.unique_id, busi.busi_code_first, busi.busi_code_second, busi.busi_code_third, busi.face_mode, busi.finger_mode, busi.iris_mode, busi.fvein_mode, busi.face_iris_mode, busi.datasource, busi.locked, busi.lock_time, busi.status, busi.remark, busi.create_by, busi.update_by, busi.create_time, busi.update_time, busi.batch_date, busi.tenant_id, busi.update_seria_num, channel.channel_code, channel.channel_name from channel_business busi
        left join channel_info channel on busi.channel_id = channel.id
    </sql>

