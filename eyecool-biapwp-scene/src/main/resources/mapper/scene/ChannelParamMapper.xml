<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.eyecool.scene.mapper.ChannelParamMapper">
    
    <resultMap type="ChannelParam" id="ChannelParamResult">
        <result property="id"    column="id"    />
        <result property="channelId"    column="channel_id"    />
        <result property="paramCode"    column="param_code"    />
        <result property="paramName"    column="param_name"    />
        <result property="paramValue"    column="param_value"    />
        <result property="bioAttestType"    column="bio_attest_type"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="batchDate"    column="batch_date"    />
        <result property="tenantId"    column="tenant_id"    />
    </resultMap>

    <sql id="selectChannelParamVo">
        select id, channel_id, param_code, param_name, param_value, bio_attest_type, remark, create_by, update_by, create_time, update_time, batch_date, tenant_id from channel_param
    </sql>

    <select id="selectChannelParamList" parameterType="ChannelParam" resultMap="ChannelParamResult">
        <include refid="selectChannelParamVo"/>
        <where>  
            <if test="channelId != null  and channelId != ''"> and channel_id = #{channelId}</if>
            <if test="paramCode != null  and paramCode != ''"> and param_code = #{paramCode}</if>
            <if test="paramName != null  and paramName != ''"> and param_name like concat(concat('%', #{paramName}), '%')</if>
            <if test="paramValue != null  and paramValue != ''"> and param_value = #{paramValue}</if>
            <if test="bioAttestType != null  and bioAttestType != ''"> and bio_attest_type = #{bioAttestType}</if>
            <if test="batchDate != null "> and batch_date = #{batchDate}</if>
            <if test="tenantId != null  and tenantId != ''"> and tenant_id = #{tenantId}</if>
        </where>
    </select>
    
    <select id="selectChannelParamById" parameterType="String" resultMap="ChannelParamResult">
        <include refid="selectChannelParamVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertChannelParam" parameterType="ChannelParam">
        insert into channel_param
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="channelId != null and channelId != ''">channel_id,</if>
            <if test="paramCode != null and paramCode != ''">param_code,</if>
            <if test="paramName != null">param_name,</if>
            <if test="paramValue != null and paramValue != ''">param_value,</if>
            <if test="bioAttestType != null and bioAttestType != ''">bio_attest_type,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="batchDate != null">batch_date,</if>
            <if test="tenantId != null">tenant_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="channelId != null and channelId != ''">#{channelId},</if>
            <if test="paramCode != null and paramCode != ''">#{paramCode},</if>
            <if test="paramName != null">#{paramName},</if>
            <if test="paramValue != null and paramValue != ''">#{paramValue},</if>
            <if test="bioAttestType != null and bioAttestType != ''">#{bioAttestType},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="batchDate != null">#{batchDate},</if>
            <if test="tenantId != null">#{tenantId},</if>
         </trim>
    </insert>

    <update id="updateChannelParam" parameterType="ChannelParam">
        update channel_param
        <trim prefix="SET" suffixOverrides=",">
            <if test="channelId != null and channelId != ''">channel_id = #{channelId},</if>
            <if test="paramCode != null and paramCode != ''">param_code = #{paramCode},</if>
            <if test="paramName != null">param_name = #{paramName},</if>
            <if test="paramValue != null and paramValue != ''">param_value = #{paramValue},</if>
            <if test="bioAttestType != null and bioAttestType != ''">bio_attest_type = #{bioAttestType},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="batchDate != null">batch_date = #{batchDate},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteChannelParamById" parameterType="String">
        delete from channel_param where id = #{id}
    </delete>

    <delete id="deleteChannelParamByIds" parameterType="String">
        delete from channel_param where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteChannelParamByChannelIds" parameterType="String">
        delete from channel_param where channel_id in
        <foreach item="channelId" collection="array" open="(" separator="," close=")">
            #{channelId}
        </foreach>
    </delete>
    
</mapper>