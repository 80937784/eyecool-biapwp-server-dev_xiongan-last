<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.eyecool.device.mapper.DeviceParamModelRelMapper">
    
    <resultMap type="DeviceParamModelRel" id="DeviceParamModelRelResult">
        <result property="id"    column="id"    />
        <result property="modelCode"    column="model_code"    />
        <result property="paramCode"    column="param_code"    />
        <result property="paramName"    column="param_name"    />
        <result property="paramDesc"    column="param_desc"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"    column="tenant_id"    />
    </resultMap>

    <sql id="selectDeviceParamModelRelVo">
        select rel.id, rel.model_code, rel.param_code, param.param_name, param.param_desc, rel.create_by, rel.update_by, rel.create_time, rel.update_time, rel.tenant_id from device_param_model_rel rel
        left join device_param_info param on rel.param_code = param.param_code
    </sql>

    <select id="selectDeviceParamModelRelList" parameterType="DeviceParamModelRel" resultMap="DeviceParamModelRelResult">
        <include refid="selectDeviceParamModelRelVo"/>
        <where>  
            <if test="modelCode != null  and modelCode != ''"> and rel.model_code = #{modelCode}</if>
            <if test="paramCode != null  and paramCode != ''"> and rel.param_code = #{paramCode}</if>
            <if test="tenantId != null  and tenantId != ''"> and rel.tenant_id = #{tenantId}</if>
        </where>
    </select>
    
    <select id="selectDeviceParamModelRelById" parameterType="String" resultMap="DeviceParamModelRelResult">
        <include refid="selectDeviceParamModelRelVo"/>
        where rel.id = #{id}
    </select>
        
    <insert id="insertDeviceParamModelRel" parameterType="DeviceParamModelRel">
        insert into device_param_model_rel
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="modelCode != null and modelCode != ''">model_code,</if>
            <if test="paramCode != null and paramCode != ''">param_code,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="tenantId != null">tenant_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="modelCode != null and modelCode != ''">#{modelCode},</if>
            <if test="paramCode != null and paramCode != ''">#{paramCode},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="tenantId != null">#{tenantId},</if>
         </trim>
    </insert>

    <update id="updateDeviceParamModelRel" parameterType="DeviceParamModelRel">
        update device_param_model_rel
        <trim prefix="SET" suffixOverrides=",">
            <if test="modelCode != null and modelCode != ''">model_code = #{modelCode},</if>
            <if test="paramCode != null and paramCode != ''">param_code = #{paramCode},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDeviceParamModelRelById" parameterType="String">
        delete from device_param_model_rel where id = #{id}
    </delete>

    <delete id="deleteDeviceParamModelRelByIds" parameterType="String">
        delete from device_param_model_rel where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteParamModelRelByModelCode" parameterType="String">
        delete from device_param_model_rel where model_code = #{modelCode}
    </delete>
    
     <delete id="deleteParamModelRelByParamCode" parameterType="String">
        delete from device_param_model_rel where param_code = #{paramCode}
    </delete>
    
</mapper>