<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.eyecool.device.mapper.DeviceParamDistributeLogMapper">
    
    <resultMap type="DeviceParamDistributeLog" id="DeviceParamDistributeLogResult">
        <result property="id"    column="id"    />
        <result property="deviceNo"    column="device_no"    />
        <result property="paramCode"    column="param_code"    />
        <result property="paramValue"    column="param_value"    />
        <result property="distributeResult"    column="distribute_result"    />
        <result property="sortIndex"    column="sort_index"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"    column="tenant_id"    />
    </resultMap>

    <sql id="selectDeviceParamDistributeLogVo">
        select id, device_no, param_code, param_value, distribute_result, sort_index, create_time, update_time, tenant_id from device_param_distribute_log
    </sql>

    <select id="selectDeviceParamDistributeLogList" parameterType="DeviceParamDistributeLog" resultMap="DeviceParamDistributeLogResult">
        <include refid="selectDeviceParamDistributeLogVo"/>
        <where>  
            <if test="deviceNo != null  and deviceNo != ''"> and device_no = #{deviceNo}</if>
            <if test="paramCode != null  and paramCode != ''"> and param_code = #{paramCode}</if>
            <if test="paramValue != null  and paramValue != ''"> and param_value = #{paramValue}</if>
            <if test="distributeResult != null  and distributeResult != ''"> and distribute_result = #{distributeResult}</if>
            <if test="sortIndex != null "> and sort_index = #{sortIndex}</if>
            <if test="tenantId != null  and tenantId != ''"> and tenant_id = #{tenantId}</if>
        </where>
        order by sort_index desc
    </select>
    
    <select id="selectDeviceParamDistributeLogById" parameterType="String" resultMap="DeviceParamDistributeLogResult">
        <include refid="selectDeviceParamDistributeLogVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertDeviceParamDistributeLog" parameterType="DeviceParamDistributeLog">
        insert into device_param_distribute_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="deviceNo != null and deviceNo != ''">device_no,</if>
            <if test="paramCode != null and paramCode != ''">param_code,</if>
            <if test="paramValue != null and paramValue != ''">param_value,</if>
            <if test="distributeResult != null">distribute_result,</if>
            <if test="sortIndex != null">sort_index,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="tenantId != null">tenant_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="deviceNo != null and deviceNo != ''">#{deviceNo},</if>
            <if test="paramCode != null and paramCode != ''">#{paramCode},</if>
            <if test="paramValue != null and paramValue != ''">#{paramValue},</if>
            <if test="distributeResult != null">#{distributeResult},</if>
            <if test="sortIndex != null">#{sortIndex},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="tenantId != null">#{tenantId},</if>
         </trim>
    </insert>

    <update id="updateDeviceParamDistributeLog" parameterType="DeviceParamDistributeLog">
        update device_param_distribute_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="deviceNo != null and deviceNo != ''">device_no = #{deviceNo},</if>
            <if test="paramCode != null and paramCode != ''">param_code = #{paramCode},</if>
            <if test="paramValue != null and paramValue != ''">param_value = #{paramValue},</if>
            <if test="distributeResult != null">distribute_result = #{distributeResult},</if>
            <if test="sortIndex != null">sort_index = #{sortIndex},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDeviceParamDistributeLogById" parameterType="String">
        delete from device_param_distribute_log where id = #{id}
    </delete>

    <delete id="deleteDeviceParamDistributeLogByIds" parameterType="String">
        delete from device_param_distribute_log where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
     <select id="selectMaxSortIndex" resultType="Long">
     	select max(sort_index) from  device_param_distribute_log
    </select>
    
    
    <update id="updateDistributeLogBySortIndex">
        update device_param_distribute_log
        set distribute_result = #{distributeResult}, update_time = #{updateTime}
        where sort_index = #{sortIndex}
    </update>
    
    
</mapper>