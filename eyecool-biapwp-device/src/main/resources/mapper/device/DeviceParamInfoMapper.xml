<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.eyecool.device.mapper.DeviceParamInfoMapper">
    
    <resultMap type="DeviceParamInfo" id="DeviceParamInfoResult">
        <result property="id"    column="id"    />
        <result property="paramCode"    column="param_code"    />
        <result property="paramName"    column="param_name"    />
        <result property="paramDesc"    column="param_desc"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"    column="tenant_id"    />
    </resultMap>

    <sql id="selectDeviceParamInfoVo">
        select id, param_code, param_name, param_desc, create_by, update_by, create_time, update_time, tenant_id from device_param_info
    </sql>

    <select id="selectDeviceParamInfoList" parameterType="DeviceParamInfo" resultMap="DeviceParamInfoResult">
        <include refid="selectDeviceParamInfoVo"/>
        <where>  
            <if test="paramCode != null  and paramCode != ''"> and param_code = #{paramCode}</if>
            <if test="paramName != null  and paramName != ''"> and param_name like concat(concat('%', #{paramName}), '%')</if>
            <if test="paramDesc != null  and paramDesc != ''"> and param_desc = #{paramDesc}</if>
            <if test="tenantId != null  and tenantId != ''"> and tenant_id = #{tenantId}</if>
        </where>
    </select>
    
    <select id="selectDeviceParamInfoById" parameterType="String" resultMap="DeviceParamInfoResult">
        <include refid="selectDeviceParamInfoVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertDeviceParamInfo" parameterType="DeviceParamInfo">
        insert into device_param_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="paramCode != null and paramCode != ''">param_code,</if>
            <if test="paramName != null and paramName != ''">param_name,</if>
            <if test="paramDesc != null">param_desc,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="tenantId != null">tenant_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="paramCode != null and paramCode != ''">#{paramCode},</if>
            <if test="paramName != null and paramName != ''">#{paramName},</if>
            <if test="paramDesc != null">#{paramDesc},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="tenantId != null">#{tenantId},</if>
         </trim>
    </insert>

    <update id="updateDeviceParamInfo" parameterType="DeviceParamInfo">
        update device_param_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="paramCode != null and paramCode != ''">param_code = #{paramCode},</if>
            <if test="paramName != null and paramName != ''">param_name = #{paramName},</if>
            <if test="paramDesc != null">param_desc = #{paramDesc},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDeviceParamInfoById" parameterType="String">
        delete from device_param_info where id = #{id}
    </delete>

    <delete id="deleteDeviceParamInfoByIds" parameterType="String">
        delete from device_param_info where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
</mapper>