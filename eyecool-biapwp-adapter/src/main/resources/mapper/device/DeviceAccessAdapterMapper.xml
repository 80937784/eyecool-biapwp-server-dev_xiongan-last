<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.eyecool.device.mapper.DeviceAccessAdapterMapper">
    
    <resultMap type="DeviceAccessAdapter" id="DeviceAccessAdapterResult">
        <result property="id"    column="id"    />
        <result property="deviceName"    column="device_name"    />
        <result property="deviceSn"    column="device_sn"    />
        <result property="seriaNum"    column="seria_num"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"    column="tenant_id"    />
    </resultMap>

    <sql id="selectDeviceAccessAdapterVo">
        select id, device_name, device_sn, seria_num, create_by, update_by, create_time, update_time, tenant_id from device_access_adapter
    </sql>

    <select id="selectDeviceAccessAdapterList" parameterType="DeviceAccessAdapter" resultMap="DeviceAccessAdapterResult">
        <include refid="selectDeviceAccessAdapterVo"/>
        <where>  
            <if test="deviceName != null  and deviceName != ''"> and device_name like concat(concat('%', #{deviceName}), '%')</if>
            <if test="deviceSn != null  and deviceSn != ''"> and device_sn = #{deviceSn}</if>
            <if test="seriaNum != null  and seriaNum != ''"> and seria_num = #{seriaNum}</if>
            <if test="tenantId != null  and tenantId != ''"> and tenant_id = #{tenantId}</if>
        </where>
    </select>
    
    <select id="selectDeviceAccessAdapterById" parameterType="String" resultMap="DeviceAccessAdapterResult">
        <include refid="selectDeviceAccessAdapterVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertDeviceAccessAdapter" parameterType="DeviceAccessAdapter">
        insert into device_access_adapter
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="deviceName != null">device_name,</if>
            <if test="deviceSn != null and deviceSn != ''">device_sn,</if>
            <if test="seriaNum != null and seriaNum != ''">seria_num,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="tenantId != null">tenant_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="deviceName != null">#{deviceName},</if>
            <if test="deviceSn != null and deviceSn != ''">#{deviceSn},</if>
            <if test="seriaNum != null and seriaNum != ''">#{seriaNum},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="tenantId != null">#{tenantId},</if>
         </trim>
    </insert>

    <update id="updateDeviceAccessAdapter" parameterType="DeviceAccessAdapter">
        update device_access_adapter
        <trim prefix="SET" suffixOverrides=",">
            <if test="deviceName != null">device_name = #{deviceName},</if>
            <if test="deviceSn != null and deviceSn != ''">device_sn = #{deviceSn},</if>
            <if test="seriaNum != null and seriaNum != ''">seria_num = #{seriaNum},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDeviceAccessAdapterById" parameterType="String">
        delete from device_access_adapter where id = #{id}
    </delete>

    <delete id="deleteDeviceAccessAdapterByIds" parameterType="String">
        delete from device_access_adapter where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
</mapper>