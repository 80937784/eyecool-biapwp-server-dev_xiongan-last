            <if test="idcardLimit != null">#{idcardLimit},</if>
            <if test="idcardExpiryDate != null">#{idcardExpiryDate},</if>
            <if test="idcardOcrFirmType != null">#{idcardOcrFirmType},</if>
            <if test="result != null">#{result},</if>
            <if test="tenantId != null and tenantId != ''">#{tenantId},</if>
         </trim>
    </insert>

    <update id="updateOcrIdcardBackLog" parameterType="OcrIdcardBackLog">
        update ocr_idcard_back_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="receivedSeq != null and receivedSeq != ''">received_seq = #{receivedSeq},</if>
            <if test="receivedTime != null">received_time = #{receivedTime},</if>
            <if test="type != null">type = #{type},</if>
            <if test="typeId != null">type_id = #{typeId},</if>
