    <select id="selectOcrIdcardBackLogList" parameterType="OcrIdcardBackLog" resultMap="OcrIdcardBackLogResult">
        <include refid="selectOcrIdcardBackLogVo"/>
        <where>  
            <if test="receivedSeq != null  and receivedSeq != ''"> and received_seq = #{receivedSeq}</if>
            <if test="receivedTime != null "> and received_time = #{receivedTime}</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="typeId != null  and typeId != ''"> and type_id = #{typeId}</if>
            <if test="channelCode != null  and channelCode != ''"> and channel_code = #{channelCode}</if>
            <if test="sceneImageUrl != null  and sceneImageUrl != ''"> and scene_image_url = #{sceneImageUrl}</if>
            <if test="sceneImageName != null  and sceneImageName != ''"> and scene_image_name = #{sceneImageName}</if>
            <if test="idcardDateIssue != null  and idcardDateIssue != ''"> and idcard_date_issue = #{idcardDateIssue}</if>
            <if test="idcardAuthorityIssue != null  and idcardAuthorityIssue != ''"> and idcard_authority_issue = #{idcardAuthorityIssue}</if>
            <if test="idcardLimit != null  and idcardLimit != ''"> and idcard_limit = #{idcardLimit}</if>
