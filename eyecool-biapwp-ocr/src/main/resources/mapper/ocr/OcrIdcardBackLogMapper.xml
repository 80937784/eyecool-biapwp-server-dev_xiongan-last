            <if test="result != null  and result != ''"> and result = #{result}</if>
            <if test="tenantId != null  and tenantId != ''"> and tenant_id = #{tenantId}</if>
        </where>
    </select>

    <select id="selectOcrIdcardBackLogById" parameterType="String" resultMap="OcrIdcardBackLogResult">
        <include refid="selectOcrIdcardBackLogVo"/>
        where id = #{id}
    </select>

    <insert id="insertOcrIdcardBackLog" parameterType="OcrIdcardBackLog">
