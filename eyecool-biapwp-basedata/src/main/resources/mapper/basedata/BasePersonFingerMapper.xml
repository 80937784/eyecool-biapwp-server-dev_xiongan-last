<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.eyecool.basedata.mapper.BasePersonFingerMapper">
    
    <resultMap type="BasePersonFinger" id="BasePersonFingerResult">
        <result property="id"    column="id"    />
        <result property="personId"    column="person_id"    />
        <result property="uniqueId"    column="unique_id"    />
        <result property="fingerNo"    column="finger_no"    />
        <result property="coercivePosition"    column="coercive_position"    />
        <result property="feature"    column="feature"    />
        <result property="featureMd5"    column="feature_md5"    />
        <result property="qualityScore"    column="quality_score"    />
        <result property="imageUrl"    column="image_url"    />
        <result property="vendorCode"    column="vendor_code"    />
        <result property="algsVersion"    column="algs_version"    />
        <result property="encrypted"    column="encrypted"    />
        <result property="datasource"    column="datasource"    />
        <result property="remark"    column="remark"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="batchDate"    column="batch_date"    />
        <result property="tenantId"    column="tenant_id"    />
    </resultMap>

    <sql id="selectBasePersonFingerVo">
        select finger.id, finger.person_id, finger.unique_id, finger.finger_no, finger.coercive_position, finger.feature, finger.feature_md5, finger.quality_score, finger.image_url, finger.vendor_code, finger.algs_version, finger.encrypted, finger.datasource, finger.remark, finger.status, finger.create_by, finger.update_by, finger.create_time, finger.update_time, finger.batch_date, finger.tenant_id from base_person_finger finger
    </sql>

    <select id="selectBasePersonFingerList" parameterType="BasePersonFinger" resultMap="BasePersonFingerResult">
        <include refid="selectBasePersonFingerVo"/> 
        left join base_person_info info on finger.person_id=info.id
        <where>  
            <if test="personId != null  and personId != ''"> and finger.person_id = #{personId}</if>
            <if test="uniqueId != null  and uniqueId != ''"> and finger.unique_id = #{uniqueId}</if>
            <if test="fingerNo != null  and fingerNo != ''"> and finger.finger_no = #{fingerNo}</if>
            <if test="coercivePosition != null  and coercivePosition != ''"> and finger.coercive_position = #{coercivePosition}</if>
            <if test="feature != null  and feature != ''"> and finger.feature = #{feature}</if>
            <if test="featureMd5 != null  and featureMd5 != ''"> and finger.feature_md5 = #{featureMd5}</if>
            <if test="qualityScore != null "> and finger.quality_score = #{qualityScore}</if>
            <if test="imageUrl != null  and imageUrl != ''"> and finger.image_url = #{imageUrl}</if>
            <if test="vendorCode != null  and vendorCode != ''"> and finger.vendor_code = #{vendorCode}</if>
            <if test="algsVersion != null  and algsVersion != ''"> and finger.algs_version = #{algsVersion}</if>
            <if test="encrypted != null  and encrypted != ''"> and finger.encrypted = #{encrypted}</if>
            <if test="datasource != null  and datasource != ''"> and finger.datasource = #{datasource}</if>
            <if test="status != null  and status != ''"> and finger.status = #{status}</if>
            <if test="batchDate != null "> and finger.batch_date = #{batchDate}</if>
            <if test="tenantId != null  and tenantId != ''"> and finger.tenant_id = #{tenantId}</if>
            <if test="params.ids != null and params.ids.size() > 0">
        	 	and finger.id in
        	 	<foreach collection="params.ids" index="index" item="item" open="(" separator="," close=")">
		            #{item}
		        </foreach>
        	</if>
        	<if test="params.personIds != null and params.personIds.size() > 0">
        	 	and finger.person_id in
        	 	<foreach collection="params.personIds" index="index" item="item" open="(" separator="," close=")">
		            #{item}
		        </foreach>
        	</if>
        	 <if test="deptId != null and deptId != 0">
				AND (info.dept_id = #{deptId} OR info.dept_id IN ( SELECT t.dept_id FROM sys_dept t WHERE find_in_set(#{deptId}, ancestors) ))
			</if>
			<!-- 数据范围过滤 -->
			${params.dataScope}
        </where>
    </select>
    
    <select id="selectBasePersonFingerById" parameterType="String" resultMap="BasePersonFingerResult">
        <include refid="selectBasePersonFingerVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertBasePersonFinger" parameterType="BasePersonFinger">
        insert into base_person_finger
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="personId != null and personId != ''">person_id,</if>
            <if test="uniqueId != null and uniqueId != ''">unique_id,</if>
            <if test="fingerNo != null and fingerNo != ''">finger_no,</if>
            <if test="coercivePosition != null and coercivePosition != ''">coercive_position,</if>
            <if test="feature != null and feature != ''">feature,</if>
            <if test="featureMd5 != null">feature_md5,</if>
            <if test="qualityScore != null">quality_score,</if>
            <if test="imageUrl != null">image_url,</if>
            <if test="vendorCode != null">vendor_code,</if>
            <if test="algsVersion != null">algs_version,</if>
            <if test="encrypted != null">encrypted,</if>
            <if test="datasource != null and datasource != ''">datasource,</if>
            <if test="remark != null">remark,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="batchDate != null">batch_date,</if>
            <if test="tenantId != null">tenant_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="personId != null and personId != ''">#{personId},</if>
            <if test="uniqueId != null and uniqueId != ''">#{uniqueId},</if>
            <if test="fingerNo != null and fingerNo != ''">#{fingerNo},</if>
            <if test="coercivePosition != null and coercivePosition != ''">#{coercivePosition},</if>
            <if test="feature != null and feature != ''">#{feature},</if>
            <if test="featureMd5 != null">#{featureMd5},</if>
            <if test="qualityScore != null">#{qualityScore},</if>
            <if test="imageUrl != null">#{imageUrl},</if>
            <if test="vendorCode != null">#{vendorCode},</if>
            <if test="algsVersion != null">#{algsVersion},</if>
            <if test="encrypted != null">#{encrypted},</if>
            <if test="datasource != null and datasource != ''">#{datasource},</if>
            <if test="remark != null">#{remark},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="batchDate != null">#{batchDate},</if>
            <if test="tenantId != null">#{tenantId},</if>
         </trim>
    </insert>

    <update id="updateBasePersonFinger" parameterType="BasePersonFinger">
        update base_person_finger
        <trim prefix="SET" suffixOverrides=",">
            <if test="personId != null and personId != ''">person_id = #{personId},</if>
