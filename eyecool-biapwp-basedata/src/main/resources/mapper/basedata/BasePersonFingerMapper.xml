    <delete id="deleteBasePersonFingerById" parameterType="String">
        delete from base_person_finger where id = #{id}
    </delete>

    <delete id="deleteBasePersonFingerByIds" parameterType="String">
        delete from base_person_finger where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <select id="countEnabledFingerByPersonId" parameterType="String" resultType="int">
        select count(1) from base_person_finger where person_id = #{personId} and status = '0'
    </select>
    
</mapper>