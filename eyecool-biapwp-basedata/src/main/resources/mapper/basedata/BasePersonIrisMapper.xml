    <delete id="deleteBasePersonIrisById" parameterType="String">
        delete from base_person_iris where id = #{id}
    </delete>

    <delete id="deleteBasePersonIrisByIds" parameterType="String">
        delete from base_person_iris where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
     
    <select id="countEnabledIrisByPersonId" parameterType="String" resultType="int">
        select count(1) from base_person_iris where person_id = #{personId} and status = '0'
    </select>
    
</mapper>