<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.eyecool.system.mapper.SysConfigMapper">
    
    <resultMap type="SysConfig" id="SysConfigResult">
    	<id     property="configId"      column="config_id"      />
        <result property="configName"    column="config_name"    />
        <result property="configKey"     column="config_key"     />
        <result property="configValue"   column="config_value"   />
        <result property="configType"    column="config_type"    />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"      column="tenant_id"    />
        <result property="tenantMaintain"   column="tenant_maintain"      />
    </resultMap>
    
    <sql id="selectConfigVo" databaseId="mysql">
        select conf.config_id, conf.config_name, conf.config_key, ifnull(tconf.config_value, conf.config_value) as config_value, conf.config_type, conf.create_by, conf.create_time, ifnull(tconf.update_by, conf.update_by) as update_by, ifnull(tconf.update_time, conf.update_time) as update_time, conf.remark, conf.tenant_maintain, tconf.tenant_id  
		from sys_config conf left join sys_tenant_config tconf on conf.config_id = tconf.config_id
    </sql>
    
    <!-- 查询条件 -->
	<sql id="sqlwhereSearch" databaseId="mysql">
		<where>
			<if test="configId !=null">
				and conf.config_id = #{configId}
			</if>
			<if test="configKey !=null and configKey != ''">
				and conf.config_key = #{configKey}
			</if>
		</where>
	</sql>
    
    <select id="selectConfig" parameterType="SysConfig" resultMap="SysConfigResult" databaseId="mysql">
        <include refid="selectConfigVo"/>
        <include refid="sqlwhereSearch"/>
    </select>
    
    <select id="selectConfigList" parameterType="SysConfig" resultMap="SysConfigResult" databaseId="mysql">
        <include refid="selectConfigVo"/>
        <where>
			<if test="configName != null and configName != ''">
				AND conf.config_name like concat(concat('%', #{configName}), '%')
			</if>
			<if test="configType != null and configType != ''">
				AND conf.config_type = #{configType}
			</if>
			<if test="configKey != null and configKey != ''">
				AND conf.config_key like concat(concat('%', #{configKey}), '%')
			</if>
			<if test="beginTime != null and beginTime != ''"><!-- 开始时间检索 -->
				and date_format(conf.create_time,'%y%m%d') &gt;= date_format(#{beginTime},'%y%m%d')
			</if>
			<if test="endTime != null and endTime != ''"><!-- 结束时间检索 -->
				and date_format(conf.create_time,'%y%m%d') &lt;= date_format(#{endTime},'%y%m%d')
			</if>
			<if test="tenantMaintain != null and tenantMaintain != ''"><!-- 是否允许租户维护 -->
				AND conf.tenant_maintain = #{tenantMaintain}
			</if>
		</where>
    </select>
    
    <select id="checkConfigKeyUnique" parameterType="String" resultMap="SysConfigResult">
        select config_id, config_name, config_key, config_value, config_type, create_by, create_time, update_by, update_time, remark 
		from sys_config where config_key = #{configKey}
    </select>
    
    <insert id="insertConfig" parameterType="SysConfig" databaseId="mysql">
        insert into sys_config (
			<if test="configName != null and configName != '' ">config_name,</if>
			<if test="configKey != null and configKey != '' ">config_key,</if>
			<if test="configValue != null and configValue != '' ">config_value,</if>
			<if test="configType != null and configType != '' ">config_type,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			<if test="remark != null and remark != ''">remark,</if>
			<if test="tenantMaintain != null and tenantMaintain != ''">tenant_maintain,</if>
 			create_time
        )values(
			<if test="configName != null and configName != ''">#{configName},</if>
			<if test="configKey != null and configKey != ''">#{configKey},</if>
			<if test="configValue != null and configValue != ''">#{configValue},</if>
			<if test="configType != null and configType != ''">#{configType},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			<if test="remark != null and remark != ''">#{remark},</if>
			<if test="tenantMaintain != null and tenantMaintain != ''">#{tenantMaintain},</if>
 			sysdate()
		)
    </insert>
	 
    <update id="updateConfig" parameterType="SysConfig" databaseId="mysql">
        update sys_config 
        <set>
            <if test="configName != null and configName != ''">config_name = #{configName},</if>
            <if test="configKey != null and configKey != ''">config_key = #{configKey},</if>
            <if test="configValue != null and configValue != ''">config_value = #{configValue},</if>
            <if test="configType != null and configType != ''">config_type = #{configType},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="tenantMaintain != null and tenantMaintain != ''">tenant_maintain = #{tenantMaintain},</if>
 			update_time = sysdate()
        </set>
        where config_id = #{configId}
    </update>
	
    <delete id="deleteConfigById" parameterType="Long">
        delete from sys_config where config_id = #{configId}
    </delete>
    
    <delete id="deleteConfigByIds" parameterType="Long">
        delete from sys_config where config_id in 
        <foreach item="configId" collection="array" open="(" separator="," close=")">
        	#{configId}
        </foreach>
    </delete>
    
    <insert id="insertTenantConfig" parameterType="SysConfig">
        insert into sys_tenant_config 
       	<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="configId != null ">config_id,</if>
			<if test="configValue != null and configValue != '' ">config_value,</if>
			<if test="tenantId != null and tenantId != '' ">tenant_id,</if>
			<if test="updateBy != null and updateBy != ''">update_by,</if>
			<if test="updateTime != null">update_time,</if>
		</trim>
       	<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="configId != null">#{configId},</if>
			<if test="configValue != null and configValue != ''">#{configValue},</if>
			<if test="tenantId != null and tenantId != '' ">#{tenantId},</if>
			<if test="updateBy != null and updateBy != ''">#{updateBy},</if>
			<if test="updateTime != null">#{updateTime},</if>
		</trim>
    </insert>
	 
    <update id="updateTenantConfig" parameterType="SysConfig">
        update sys_tenant_config
        <trim prefix="SET" suffixOverrides=",">
			<if test="configValue != null and configValue != ''">config_value = #{configValue},</if>
			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
			<if test="updateTime != null">update_time = #{updateTime},</if>
       	</trim>
        where config_id = #{configId}
    </update>
	
    <delete id="deleteTenantConfigByConfigId" parameterType="Long">
        delete from sys_tenant_config where config_id = #{configId}
    </delete>
    
    <delete id="deleteTenantConfigByConfigIds" parameterType="Long">
        delete from sys_tenant_config where config_id in
        <foreach item="configId" collection="array" open="(" separator="," close=")">
        	#{configId}
        </foreach>
    </delete>
    
    <select id="getTenantConfigListByConfigKey" parameterType="String" resultMap="SysConfigResult" >
        select tconf.tenant_id,conf.config_key, tconf.config_value 
		from sys_config conf left join sys_tenant_config tconf on conf.config_id = tconf.config_id 
		where conf.config_key = #{configKey}
    </select>
    
    
</mapper>