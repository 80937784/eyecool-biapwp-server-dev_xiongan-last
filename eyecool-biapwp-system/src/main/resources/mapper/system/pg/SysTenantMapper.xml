<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.eyecool.system.mapper.SysTenantMapper">
        
    <insert id="insertSysTenant" parameterType="SysTenant" databaseId="postgresql">
    	<selectKey keyProperty="id" order="BEFORE" resultType="Long">
			SELECT nextval('sys_tenant_id_seq'::regclass) as id
		</selectKey>
        insert into sys_tenant
        <trim prefix="(" suffix=")" suffixOverrides=",">
         	<if test="id != null and id != 0">id,</if>
            <if test="tenantId != null and tenantId != ''">tenant_id,</if>
            <if test="tenantName != null">tenant_name,</if>
            <if test="tenantDesc != null">tenant_desc,</if>
            <if test="tenantState != null">tenant_state,</if>
            <if test="createSource != null">create_source,</if>
            <if test="effectiveTime != null">effective_time,</if>
            <if test="expireTime != null">expire_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
        	<if test="id != null and id != 0">#{id},</if>
            <if test="tenantId != null and tenantId != ''">#{tenantId},</if>
            <if test="tenantName != null">#{tenantName},</if>
            <if test="tenantDesc != null">#{tenantDesc},</if>
            <if test="tenantState != null">#{tenantState},</if>
            <if test="createSource != null">#{createSource},</if>
            <if test="effectiveTime != null">#{effectiveTime},</if>
            <if test="expireTime != null">#{expireTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

</mapper>