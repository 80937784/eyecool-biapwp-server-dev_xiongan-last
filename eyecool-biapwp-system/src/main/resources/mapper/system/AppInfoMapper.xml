<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.eyecool.system.mapper.AppInfoMapper">
    
    <resultMap type="AppInfo" id="AppInfoResult">
        <result property="id"    column="id"    />
        <result property="appKey"    column="app_key"    />
        <result property="appSecret"    column="app_secret"    />
        <result property="appDesc"    column="app_desc"    />
        <result property="builtIn"    column="built_in"    />
        <result property="remark"    column="remark"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"    column="tenant_id"    />
    </resultMap>

    <sql id="selectAppInfoVo">
        select id, app_key, app_secret, app_desc, built_in, remark, status, create_by, update_by, create_time, update_time, tenant_id from app_info
    </sql>

    <select id="selectAppInfoList" parameterType="AppInfo" resultMap="AppInfoResult">
        <include refid="selectAppInfoVo"/>
        <where>  
            <if test="appKey != null  and appKey != ''"> and app_key = #{appKey}</if>
            <if test="appSecret != null  and appSecret != ''"> and app_secret = #{appSecret}</if>
            <if test="appDesc != null  and appDesc != ''"> and app_desc like concat(concat('%', #{appDesc}), '%')</if>
            <if test="builtIn != null  and builtIn != ''"> and built_in = #{builtIn}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="tenantId != null  and tenantId != ''"> and tenant_id = #{tenantId}</if>
        </where>
    </select>
    
    <select id="selectAppInfoById" parameterType="String" resultMap="AppInfoResult">
        <include refid="selectAppInfoVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertAppInfo" parameterType="AppInfo">
        insert into app_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="appKey != null and appKey != ''">app_key,</if>
            <if test="appSecret != null and appSecret != ''">app_secret,</if>
            <if test="appDesc != null">app_desc,</if>
            <if test="builtIn != null and builtIn != ''">built_in,</if>
            <if test="remark != null">remark,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="tenantId != null">tenant_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="appKey != null and appKey != ''">#{appKey},</if>
            <if test="appSecret != null and appSecret != ''">#{appSecret},</if>
            <if test="appDesc != null">#{appDesc},</if>
            <if test="builtIn != null and builtIn != ''">#{builtIn},</if>
            <if test="remark != null">#{remark},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="tenantId != null">#{tenantId},</if>
         </trim>
    </insert>

    <update id="updateAppInfo" parameterType="AppInfo">
        update app_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="appKey != null and appKey != ''">app_key = #{appKey},</if>
            <if test="appSecret != null and appSecret != ''">app_secret = #{appSecret},</if>
            <if test="appDesc != null">app_desc = #{appDesc},</if>
            <if test="builtIn != null and builtIn != ''">built_in = #{builtIn},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAppInfoById" parameterType="String">
        delete from app_info where id = #{id}
    </delete>

    <delete id="deleteAppInfoByIds" parameterType="String">
        delete from app_info where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
</mapper>