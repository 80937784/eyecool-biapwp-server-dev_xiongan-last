<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.eyecool.system.mapper.SysTenantRoleMapper">

	<resultMap type="SysTenantRole" id="SysTenantRoleResult">
		<id     property="id"                 column="id"               />
		<result property="roleName"           column="role_name"             />
		<result property="roleKey"            column="role_key"              />
		<result property="roleSort"           column="role_sort"             />
		<result property="menuCheckStrictly"  column="menu_check_strictly"   />
		<result property="status"             column="status"                />
		<result property="delFlag"            column="del_flag"              />
		<result property="createBy"           column="create_by"             />
		<result property="createTime"         column="create_time"           />
		<result property="updateBy"           column="update_by"             />
		<result property="updateTime"         column="update_time"           />
		<result property="remark"             column="remark"                />
	</resultMap>
	
	<sql id="selectTenantRoleVo">
	    select distinct r.id, r.role_name, r.role_key, r.role_sort, r.menu_check_strictly,
            r.status, r.del_flag, r.create_time, r.remark
        from sys_tenant_role r
	        left join sys_tenant t on t.tenant_role_id = r.id
    </sql>
    
    <select id="selectTenantRoleList" parameterType="SysTenantRole" resultMap="SysTenantRoleResult">
		<include refid="selectTenantRoleVo"/>
		where r.del_flag = '0'
		<if test="roleName != null and roleName != ''">
			AND r.role_name like concat(concat('%', #{roleName}), '%')
		</if>
		<if test="status != null and status != ''">
			AND r.status = #{status}
		</if>
		<if test="roleKey != null and roleKey != ''">
			AND r.role_key like concat(concat('%', #{roleKey}), '%')
		</if>
		order by r.role_sort asc
	</select>
    
	<select id="selectTenantRolePermissionByTenantId" parameterType="String" resultMap="SysTenantRoleResult">
		<include refid="selectTenantRoleVo"/>
		WHERE r.del_flag = '0' and t.tenant_id = #{tenantId}
	</select>
	
	<select id="selectTenantRoleAll" resultMap="SysTenantRoleResult">
		<include refid="selectTenantRoleVo"/>
	</select>
	
	<select id="selectTenantRoleListByTenantId" parameterType="String" resultType="String">
		select r.id
        from sys_tenant_role r
	        left join sys_tenant t on t.tenant_role_id = r.id
	    where t.tenant_id = #{tenantId}
	</select>
	
	<select id="selectTenantRoleById" parameterType="String" resultMap="SysTenantRoleResult">
		<include refid="selectTenantRoleVo"/>
		where r.id = #{id}
	</select>
	
	<select id="checkTenantRoleNameUnique" parameterType="String" resultMap="SysTenantRoleResult">
		<include refid="selectTenantRoleVo"/>
		 where r.role_name=#{roleName}
	</select>
	
	<select id="checkTenantRoleKeyUnique" parameterType="String" resultMap="SysTenantRoleResult">
		<include refid="selectTenantRoleVo"/>
		 where r.role_key=#{roleKey}
	</select>
	
 	<insert id="insertTenantRole" parameterType="SysTenantRole">
 		insert into sys_tenant_role
 		<trim prefix="(" suffix=")" suffixOverrides=",">
 			<if test="id != null and id != ''">id,</if>
 			<if test="roleName != null and roleName != ''">role_name,</if>
 			<if test="roleKey != null and roleKey != ''">role_key,</if>
 			<if test="roleSort != null and roleSort != ''">role_sort,</if>
 			<if test="menuCheckStrictly != null">menu_check_strictly,</if>
 			<if test="status != null and status != ''">status,</if>
 			<if test="remark != null and remark != ''">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			<if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
 		<trim prefix="values (" suffix=")" suffixOverrides=",">
 			<if test="id != null and id != ''">#{id},</if>
 			<if test="roleName != null and roleName != ''">#{roleName},</if>
 			<if test="roleKey != null and roleKey != ''">#{roleKey},</if>
 			<if test="roleSort != null and roleSort != ''">#{roleSort},</if>
 			<if test="menuCheckStrictly != null">#{menuCheckStrictly},</if>
 			<if test="status != null and status != ''">#{status},</if>
 			<if test="remark != null and remark != ''">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			<if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
 		</trim>
	</insert>
	
	<update id="updateTenantRole" parameterType="SysTenantRole">
 		update sys_tenant_role
 		 <trim prefix="SET" suffixOverrides=",">
 			<if test="roleName != null and roleName != ''">role_name = #{roleName},</if>
 			<if test="roleKey != null and roleKey != ''">role_key = #{roleKey},</if>
 			<if test="roleSort != null and roleSort != ''">role_sort = #{roleSort},</if>
 			<if test="menuCheckStrictly != null">menu_check_strictly = #{menuCheckStrictly},</if>
 			<if test="status != null and status != ''">status = #{status},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
 		 </trim>
 		where id = #{id}
	</update>
	
	<delete id="deleteTenantRoleById" parameterType="String">
 		delete from sys_tenant_role where id = #{id}
 	</delete>
 	
 	<delete id="deleteTenantRoleByIds" parameterType="String">
 	    update sys_tenant_role set del_flag = '2' where id in
 		<foreach collection="array" item="id" open="(" separator="," close=")">
 			#{id}
        </foreach> 
 	</delete>
 	
</mapper> 