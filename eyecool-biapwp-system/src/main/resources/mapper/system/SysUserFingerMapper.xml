<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.eyecool.system.mapper.SysUserFingerMapper">
    
    <resultMap type="SysUserFinger" id="SysUserFingerResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="fingerNo"    column="finger_no"    />
        <result property="feature"    column="feature"    />
        <result property="featureMd5"    column="feature_md5"    />
        <result property="qualityScore"    column="quality_score"    />
        <result property="imageUrl"    column="image_url"    />
        <result property="vendorCode"    column="vendor_code"    />
        <result property="algsVersion"    column="algs_version"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"    column="tenant_id"    />
    </resultMap>

    <sql id="selectSysUserFingerVo">
        select id, user_id, finger_no, feature, feature_md5, quality_score, image_url, vendor_code, algs_version, status, remark, create_by, update_by, create_time, update_time, tenant_id from sys_user_finger
    </sql>

    <select id="selectSysUserFingerList" parameterType="SysUserFinger" resultMap="SysUserFingerResult">
        <include refid="selectSysUserFingerVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="fingerNo != null  and fingerNo != ''"> and finger_no = #{fingerNo}</if>
            <if test="feature != null  and feature != ''"> and feature = #{feature}</if>
            <if test="featureMd5 != null  and featureMd5 != ''"> and feature_md5 = #{featureMd5}</if>
            <if test="qualityScore != null "> and quality_score = #{qualityScore}</if>
            <if test="imageUrl != null  and imageUrl != ''"> and image_url = #{imageUrl}</if>
            <if test="vendorCode != null  and vendorCode != ''"> and vendor_code = #{vendorCode}</if>
            <if test="algsVersion != null  and algsVersion != ''"> and algs_version = #{algsVersion}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="tenantId != null  and tenantId != ''"> and tenant_id = #{tenantId}</if>
        </where>
    </select>
    
    <select id="selectSysUserFingerById" parameterType="String" resultMap="SysUserFingerResult">
        <include refid="selectSysUserFingerVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertSysUserFinger" parameterType="SysUserFinger">
        insert into sys_user_finger
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="userId != null">user_id,</if>
            <if test="fingerNo != null and fingerNo != ''">finger_no,</if>
            <if test="feature != null and feature != ''">feature,</if>
            <if test="featureMd5 != null">feature_md5,</if>
            <if test="qualityScore != null">quality_score,</if>
            <if test="imageUrl != null">image_url,</if>
            <if test="vendorCode != null">vendor_code,</if>
            <if test="algsVersion != null">algs_version,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="tenantId != null">tenant_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="userId != null">#{userId},</if>
            <if test="fingerNo != null and fingerNo != ''">#{fingerNo},</if>
            <if test="feature != null and feature != ''">#{feature},</if>
            <if test="featureMd5 != null">#{featureMd5},</if>
            <if test="qualityScore != null">#{qualityScore},</if>
            <if test="imageUrl != null">#{imageUrl},</if>
            <if test="vendorCode != null">#{vendorCode},</if>
            <if test="algsVersion != null">#{algsVersion},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="tenantId != null">#{tenantId},</if>
         </trim>
    </insert>

    <update id="updateSysUserFinger" parameterType="SysUserFinger">
        update sys_user_finger
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="fingerNo != null and fingerNo != ''">finger_no = #{fingerNo},</if>
            <if test="feature != null and feature != ''">feature = #{feature},</if>
            <if test="featureMd5 != null">feature_md5 = #{featureMd5},</if>
            <if test="qualityScore != null">quality_score = #{qualityScore},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="vendorCode != null">vendor_code = #{vendorCode},</if>
            <if test="algsVersion != null">algs_version = #{algsVersion},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysUserFingerById" parameterType="String">
        delete from sys_user_finger where id = #{id}
    </delete>

    <delete id="deleteSysUserFingerByIds" parameterType="String">
        delete from sys_user_finger where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

	<delete id="deleteSysUserFingerByUserId" parameterType="Long">
        delete from sys_user_finger where user_id = #{userId}
    </delete>
    
</mapper>