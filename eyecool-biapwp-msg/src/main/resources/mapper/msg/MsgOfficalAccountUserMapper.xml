<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.eyecool.msg.mapper.MsgOfficalAccountUserMapper">
    
    <resultMap type="MsgOfficalAccountUser" id="MsgOfficalAccountUserResult">
        <result property="id"    column="id"    />
        <result property="officalAccountId"    column="offical_account_id"    />
        <result property="officalAccountName"    column="app_name"    />
        <result property="appId"    column="app_id"    />
        <result property="openId"    column="open_id"    />
        <result property="wxName"    column="wx_name"    />
        <result property="headImgUrl"    column="head_img_url"    />
        <result property="phone"    column="phone"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"    column="tenant_id"    />
    </resultMap>

    <sql id="selectMsgOfficalAccountUserVo">
        select u.id, u.offical_account_id, offical.app_name, u.app_id, u.open_id, u.wx_name, u.head_img_url, u.phone, u.create_time, u.update_time, u.tenant_id 
        from msg_offical_account_user u
        left join msg_offical_account offical on u.offical_account_id = offical.id
    </sql>

    <select id="selectMsgOfficalAccountUserList" parameterType="MsgOfficalAccountUser" resultMap="MsgOfficalAccountUserResult">
        <include refid="selectMsgOfficalAccountUserVo"/>
        <where>  
            <if test="officalAccountId != null  and officalAccountId != ''"> and u.offical_account_id = #{officalAccountId}</if>
            <if test="officalAccountName != null  and officalAccountName != ''"> and offical.app_name like concat(concat('%', #{officalAccountName}), '%')</if>
            <if test="appId != null  and appId != ''"> and u.app_id = #{appId}</if>
            <if test="openId != null  and openId != ''"> and u.open_id = #{openId}</if>
            <if test="wxName != null  and wxName != ''"> and u.wx_name like concat(concat('%', #{wxName}), '%')</if>
            <if test="headImgUrl != null  and headImgUrl != ''"> and u.head_img_url = #{headImgUrl}</if>
            <if test="phone != null  and phone != ''"> and u.phone = #{phone}</if>
            <if test="tenantId != null  and tenantId != ''"> and u.tenant_id = #{tenantId}</if>
             <if test="params != null and params.openIds != null and params.openIds.size() > 0"> 
            	and u.open_id in
            	<foreach collection="params.openIds" index="index" item="item" open="(" separator="," close=")">
		            #{item}
		        </foreach>
            </if>
            <if test="params != null and params.phoneList != null and params.phoneList.size() > 0"> 
            	and u.phone in
            	<foreach collection="params.phoneList" index="index" item="item" open="(" separator="," close=")">
		            #{item}
		        </foreach>
            </if>
        </where>
    </select>
    
    <select id="selectMsgOfficalAccountUserById" parameterType="String" resultMap="MsgOfficalAccountUserResult">
        <include refid="selectMsgOfficalAccountUserVo"/>
        where u.id = #{id}
    </select>
        
    <insert id="insertMsgOfficalAccountUser" parameterType="MsgOfficalAccountUser">
        insert into msg_offical_account_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="officalAccountId != null">offical_account_id,</if>
            <if test="appId != null and appId != ''">app_id,</if>
            <if test="openId != null and openId != ''">open_id,</if>
            <if test="wxName != null and wxName != ''">wx_name,</if>
            <if test="headImgUrl != null">head_img_url,</if>
            <if test="phone != null">phone,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="tenantId != null">tenant_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="officalAccountId != null">#{officalAccountId},</if>
            <if test="appId != null and appId != ''">#{appId},</if>
            <if test="openId != null and openId != ''">#{openId},</if>
            <if test="wxName != null and wxName != ''">#{wxName},</if>
            <if test="headImgUrl != null">#{headImgUrl},</if>
            <if test="phone != null">#{phone},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="tenantId != null">#{tenantId},</if>
         </trim>
    </insert>

    <update id="updateMsgOfficalAccountUser" parameterType="MsgOfficalAccountUser">
        update msg_offical_account_user
        <trim prefix="SET" suffixOverrides=",">
            <if test="officalAccountId != null">offical_account_id = #{officalAccountId},</if>
            <if test="appId != null and appId != ''">app_id = #{appId},</if>
            <if test="openId != null and openId != ''">open_id = #{openId},</if>
            <if test="wxName != null and wxName != ''">wx_name = #{wxName},</if>
            <if test="headImgUrl != null">head_img_url = #{headImgUrl},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMsgOfficalAccountUserById" parameterType="String">
        delete from msg_offical_account_user where id = #{id}
    </delete>

    <delete id="deleteMsgOfficalAccountUserByIds" parameterType="String">
        delete from msg_offical_account_user where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteAccountUserByAccountId" parameterType="String">
        delete from msg_offical_account_user where offical_account_id = #{officalAccountId}
    </delete>
    
</mapper>